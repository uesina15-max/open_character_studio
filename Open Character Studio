function toggleProportionOverlay(v) { proportionOverlayActive = v; redrawAllLayers(); }
function togglePoseGuide(v) { poseGuideActive = v; redrawAllLayers(); }

function addCharacterGuide() {
  const vt = activeView === 'side' ? 'side' : 'front';
  addLayer("Guide Layer", vt);
  const ctx = currentLayer.ctx;
  ctx.lineWidth = 1; ctx.font = "13px sans-serif";
