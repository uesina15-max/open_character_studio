<script>
// ═══════════════════════════════════════════════
// DATA MODEL
// ═══════════════════════════════════════════════
const CharacterTypes = [
  { name: "SSD (Chibi)",         maxRatio: 2.5 },
  { name: "SD (Super Deformed)", maxRatio: 4.0 },
  { name: "MD (Semi-Realistic)", maxRatio: 6.5 },
  { name: "LD (Realistic)",      maxRatio: Infinity }
];
const MAX_HISTORY = 25;
const SNAP_GRID = 25;
const CLOSE_SNAP_DIST = 18; // px to snap to first point for closed path

let layers = [];
let currentLayer = null;
let drawing = false;
let toolMode = "brush";
let symmetryMode = false;
let lastX = 0, lastY = 0;
let measureMode = false;
let headTop = null, chin = null, foot = null;
let calculatedRatio = 6.0;
let calculatedType = "MD";
let proportionOverlayActive = false;
let poseGuideActive = false;

// ── Bezier state ──────────────────────────────
// bezierMode: 'quadratic' | 'cubic'
let bezierMode = 'quadratic';
// In-progress points array.
// Quadratic: [p0, p1, cp]  (3 clicks)
// Cubic:     [p0, p1, cp1, cp2] (4 clicks)
let bPts = [];          // current in-progress clicks
let mousePos = { x: 0, y: 0 }; // live mouse for preview

// Edit mode
let selectedShape = null;
let selectedNodeKey = null;
let isDraggingNode = false;

// Layer drag
let dragSrcIndex = null;

// ── View state ──────────────────────────────
// 'front' | 'side' | 'split'
let activeView = 'split';

// ═══════════════════════════════════════════════
// BEZIER HELPERS
// ═══════════════════════════════════════════════
function bezierStepCount() {
  return bezierMode === 'cubic' ? 4 : 3;
}

// Step labels per mode
function bezierStepLabels() {
  if (bezierMode === 'quadratic') {
    return [
      { label: 'P0', hint: '시작점' },
      { label: 'P1', hint: '끝점' },
      { label: 'CP', hint: '제어점' }
    ];
  } else {
    return [
      { label: 'P0',  hint: '시작점' },
      { label: 'P1',  hint: '끝점' },
      { label: 'CP1', hint: '제어1' },
      { label: 'CP2', hint: '제어2' }
    ];
  }
}

function setBezierMode(mode) {
  bezierMode = mode;
  bPts = [];
  document.getElementById('tab-quadratic').classList.toggle('active', mode === 'quadratic');
  document.getElementById('tab-cubic').classList.toggle('active', mode === 'cubic');
  updateBezierStepUI();
  redrawAllLayers();
}

function updateBezierStepUI() {
  const ui = document.getElementById('bezier-step-ui');
  const labels = bezierStepLabels();
  const n = labels.length;
  let html = '';
  labels.forEach((s, i) => {
    let dotClass = 'bezier-step-dot';
    if (i < bPts.length)      dotClass += ' done';
    else if (i === bPts.length) dotClass += ' active';

    html += `<div class="bezier-step">
      <div class="${dotClass}">${s.label}</div>
      <div class="bezier-step-label">${s.hint}</div>
    </div>`;
    if (i < n - 1) html += `<div class="bezier-step-arrow">›</div>`;
  });
  ui.innerHTML = html;

  // undo point button (may not exist in DOM if panel hidden at init)
  const undoBtn = document.getElementById('bezierUndoPointBtn');
  if (undoBtn) {
    undoBtn.disabled = bPts.length === 0;
    undoBtn.style.opacity = bPts.length === 0 ? '0.4' : '1';
  }
}

function cancelBezier() {
  bPts = [];
  updateBezierStepUI();
  hideCloseSnapIndicator();
  redrawAllLayers();
}

function undoBezierPoint() {
  if (bPts.length > 0) {
    bPts.pop();
    updateBezierStepUI();
    redrawAllLayers();
  }
}

function snapPoint(x, y) {
  if (!document.getElementById('bezierSnap').checked) return { x, y };
  return {
    x: Math.round(x / SNAP_GRID) * SNAP_GRID,
    y: Math.round(y / SNAP_GRID) * SNAP_GRID
  };
}

// Check if mouse is near P0 (first bezier point) for close-path snap
function nearFirstPoint(x, y) {
  if (bPts.length === 0) return false;
  const p0 = bPts[0];
  return Math.hypot(x - p0.x, y - p0.y) < CLOSE_SNAP_DIST;
}

function showCloseSnapIndicator(canvasX, canvasY) {
  const hostId = activeView === 'side' ? 'host-side' : 'host-front';
  const host = document.getElementById(hostId);
  if (!host) return;
  const rect = host.getBoundingClientRect();
  const el = document.getElementById('close-snap-indicator');
  el.style.display = 'block';
  el.style.width = el.style.height = (CLOSE_SNAP_DIST * 2) + 'px';
  const cx = rect.left + rect.width / 2 - 400 + canvasX;
  const cy = rect.top  + rect.height / 2 - 300 + canvasY;
  el.style.left = (cx - CLOSE_SNAP_DIST) + 'px';
  el.style.top  = (cy - CLOSE_SNAP_DIST) + 'px';
}
function hideCloseSnapIndicator() {
  document.getElementById('close-snap-indicator').style.display = 'none';
}

// ═══════════════════════════════════════════════
// KEYBOARD SHORTCUTS
// ═══════════════════════════════════════════════
document.addEventListener('keydown', e => {
  const tag = document.activeElement.tagName.toLowerCase();
  if (tag === 'input' || tag === 'select' || tag === 'textarea') return;

  if (e.key === 'Escape') { cancelBezier(); return; }

  if (e.ctrlKey || e.metaKey) {
    if (e.key === 'z') { e.preventDefault(); undo(); showToast('Undo'); }
    if (e.key === 'y' || (e.shiftKey && e.key === 'z')) { e.preventDefault(); redo(); showToast('Redo'); }
    if (e.key === 'd') { e.preventDefault(); duplicateLayer(); showToast('레이어 복제'); }
    if (e.key === 'e') { e.preventDefault(); mergeDown(); showToast('레이어 병합'); }
  } else {
    if (e.key === 'b') { setTool('brush'); showToast('브러시 (B)'); }
    if (e.key === 'e') { setTool('eraser'); showToast('지우개 (E)'); }
    if (e.key === 'f') { setTool('fill'); showToast('페인트통 (F)'); }
    if (e.key === 'p') { setTool('bezier'); showToast('베지어 (P)'); }
    if (e.key === 'n') { const vt = document.getElementById('newLayerTarget')?.value || (activeView === 'side' ? 'side' : 'front'); addLayer(undefined, vt); showToast('새 레이어 (N)'); }
    if (e.key === 'Delete' || e.key === 'Backspace') {
      if (toolMode === 'edit' && selectedShape) {
        deleteSelectedShape();
      } else {
        deleteCurrentLayer();
      }
    }
    if (e.key === '[') { moveLayerUp(); }
    if (e.key === ']') { moveLayerDown(); }
    if (e.key === 'h') { toggleVisibility(); showToast('가시성 토글 (H)'); }
    if (e.key === 'l') { toggleLock(); showToast('잠금 토글 (L)'); }
    if (e.key === 'z' && toolMode === 'bezier') { undoBezierPoint(); }
  }
});

let toastTimer = null;
function showToast(msg) {
  const t = document.getElementById('shortcut-toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 1400);
}

document.getElementById("symmetryToggle").addEventListener("change", function () {
  symmetryMode = this.checked;
  redrawAllLayers();
});

// ═══════════════════════════════════════════════
// TOOLS
// ═══════════════════════════════════════════════
function setTool(mode) {
  toolMode = mode;
  document.querySelectorAll("[id^='tool-']").forEach(b => b.classList.remove("btn-active"));
  const btn = document.getElementById(`tool-${mode}`);
  if (btn) btn.classList.add("btn-active");

  // Reset bezier state
  bPts = [];
  selectedShape = null;
  selectedNodeKey = null;
  hideCloseSnapIndicator();

  // Show/hide bezier section
  const sec = document.getElementById('bezier-section');
  const bezPanel = document.getElementById('bezier-panel');
  const editPanel = document.getElementById('edit-panel');
  const fillPanel = document.getElementById('fill-panel');

  if (mode === 'bezier') {
    sec.style.display = 'block';
    if (bezPanel) bezPanel.style.display = 'flex';
    if (editPanel) editPanel.style.display = 'none';
    if (fillPanel) fillPanel.style.display = 'none';
    updateBezierStepUI();
  } else if (mode === 'fill') {
    sec.style.display = 'block';
    if (bezPanel) bezPanel.style.display = 'none';
    if (editPanel) editPanel.style.display = 'none';
    if (fillPanel) fillPanel.style.display = 'flex';
  } else {
    sec.style.display = 'none';
    if (editPanel) editPanel.style.display = 'none';
    if (fillPanel) fillPanel.style.display = 'none';
  }

  updateShapeList();
  updateSelectedShapeInfo();
  redrawAllLayers();
}

// ═══════════════════════════════════════════════
// SHAPE LIST UI
// ═══════════════════════════════════════════════
function updateShapeList() {
  const wrap = document.getElementById('shape-list-wrap');
  const countEl = document.getElementById('shape-count');
  if (!wrap || !countEl) return;
  if (!currentLayer) {
    countEl.textContent = '(0)';
    wrap.innerHTML = '<div class="shape-list-empty">선택된 레이어가 없습니다</div>';
    return;
  }

  const shapes = currentLayer.shapes.filter(s => s.type === 'bezier' || s.type === 'cubic');
  countEl.textContent = `(${shapes.length})`;

  if (shapes.length === 0) {
    wrap.innerHTML = '<div class="shape-list-empty">베지어 곡선이 없습니다</div>';
    return;
  }

  wrap.innerHTML = '';
  shapes.forEach((s, i) => {
    const item = document.createElement('div');
    item.className = 'shape-item' + (s === selectedShape ? ' selected' : '');

    const dot = document.createElement('div');
    dot.className = 'shape-color-dot';
    dot.style.background = s.color;

    const name = document.createElement('div');
    name.className = 'shape-item-name';
    const typeLabel = s.type === 'cubic' ? 'Cubic' : 'Quad';
    name.textContent = `${typeLabel} #${i + 1}  w:${s.width}`;

    const del = document.createElement('button');
    del.className = 'shape-item-del';
    del.title = '삭제';
    del.textContent = '✕';
    del.addEventListener('click', ev => {
      ev.stopPropagation();
      const idx = currentLayer.shapes.indexOf(s);
      if (idx !== -1) currentLayer.shapes.splice(idx, 1);
      if (selectedShape === s) { selectedShape = null; selectedNodeKey = null; }
      saveHistory(currentLayer);
      updateShapeList();
      updateSelectedShapeInfo();
      redrawAllLayers();
      setTimeout(refreshThumbnails, 50);
    });

    item.appendChild(dot);
    item.appendChild(name);
    item.appendChild(del);
    item.addEventListener('click', () => {
      selectedShape = s;
      selectedNodeKey = null;
      updateShapeList();
      updateSelectedShapeInfo();
      redrawAllLayers();
    });
    wrap.appendChild(item);
  });
}

function updateSelectedShapeInfo() {
  const el = document.getElementById('selected-shape-info');
  const btn = document.getElementById('deleteShapeBtn');
  if (!el || !btn) return;

  if (!selectedShape) {
    el.textContent = '선택된 shape 없음';
    btn.disabled = true; btn.style.opacity = '0.4';
  } else {
    const t = selectedShape.type === 'cubic' ? 'Cubic Bezier' : 'Quadratic Bezier';
    el.textContent = `${t} | color: ${selectedShape.color} | w: ${selectedShape.width}`;
    btn.disabled = false; btn.style.opacity = '1';
  }
}

function deleteSelectedShape() {
  if (!currentLayer || !selectedShape) return;
  const idx = currentLayer.shapes.indexOf(selectedShape);
  if (idx !== -1) currentLayer.shapes.splice(idx, 1);
  selectedShape = null; selectedNodeKey = null;
  saveHistory(currentLayer);
  updateShapeList();
  updateSelectedShapeInfo();
  redrawAllLayers();
  setTimeout(refreshThumbnails, 50);
  showToast('Shape 삭제됨');
}

// ═══════════════════════════════════════════════
// VIEW MANAGEMENT
// ═══════════════════════════════════════════════
function setActiveView(view) {
  activeView = view;

  const panelFront   = document.getElementById('panel-front');
  const panelSide    = document.getElementById('panel-side');
  const panelDivider = document.getElementById('panel-divider');

  // Tab highlight
  ['front','side','split'].forEach(v => {
    const t = document.getElementById('tab-' + v);
    if (t) t.classList.toggle('active', v === view);
  });

  if (view === 'front') {
    panelFront.classList.remove('hidden');
    panelSide.classList.add('hidden');
    panelDivider.style.display = 'none';
  } else if (view === 'side') {
    panelFront.classList.add('hidden');
    panelSide.classList.remove('hidden');
    panelDivider.style.display = 'none';
  } else {
    // split
    panelFront.classList.remove('hidden');
    panelSide.classList.remove('hidden');
    panelDivider.style.display = 'block';
  }

  // Re-home all layer canvases into the correct host
  rehomeCanvases();
}

// Move every layer's canvas into the host matching its viewTarget
function rehomeCanvases() {
  const hostFront = document.getElementById('host-front');
  const hostSide  = document.getElementById('host-side');
  layers.forEach(layer => {
    const target = layer.viewTarget === 'side' ? hostSide : hostFront;
    if (layer.canvas.parentNode !== target) {
      target.appendChild(layer.canvas);
    }
  });
}

// ═══════════════════════════════════════════════
// LAYER CORE
// ═══════════════════════════════════════════════
function addLayer(baseName = "Layer", viewTarget = null) {
  // Determine which view this layer belongs to
  // If activeView is 'split' or 'front' → front; if 'side' → side
  // But caller can override via viewTarget arg (used by importProject)
  const vt = viewTarget || (activeView === 'side' ? 'side' : 'front');

  const canvas = document.createElement("canvas");
  canvas.width = 800; canvas.height = 600;
  canvas.style.zIndex = layers.length;

  const hostId = vt === 'side' ? 'host-side' : 'host-front';
  document.getElementById(hostId).appendChild(canvas);

  const ctx = canvas.getContext("2d");
  const newLayer = {
    canvas, ctx,
    name: baseName.includes("Layer") ? `${baseName} ${layers.length + 1}` : baseName,
    visible: true, locked: false,
    blendMode: "source-over",
    viewTarget: vt,
    shapes: [],
    history: [], historyStep: -1
  };

  canvas.addEventListener("pointerdown", startDraw);
  canvas.addEventListener("pointermove", draw);
  canvas.addEventListener("pointerup", endDraw);
  canvas.addEventListener("pointerout", endDraw);
  // Live preview for bezier
  canvas.addEventListener("mousemove", onCanvasMouseMove);

  layers.push(newLayer);
  currentLayer = newLayer;
  saveHistory(newLayer);
  rebuildLayerList();
  redrawAllLayers();
}

function onCanvasMouseMove(e) {
  if (!currentLayer) return;
  // Only update mousePos when moving over the active view's host
  const thisHost = e.currentTarget.parentNode; // canvas → canvas-host
  const activeHost = document.getElementById(
    currentLayer.viewTarget === 'side' ? 'host-side' : 'host-front'
  );
  if (thisHost !== activeHost) return;
  const rect = currentLayer.canvas.getBoundingClientRect();
  mousePos.x = e.clientX - rect.left;
  mousePos.y = e.clientY - rect.top;

  if (toolMode === 'bezier' && bPts.length > 0) {
    // Check close-path snap
    if (document.getElementById('bezierClosePath').checked && nearFirstPoint(mousePos.x, mousePos.y)) {
      showCloseSnapIndicator(bPts[0].x, bPts[0].y);
    } else {
      hideCloseSnapIndicator();
    }
    redrawAllLayers();
  } else {
    hideCloseSnapIndicator();
  }
}

function deleteCurrentLayer() {
  if (!currentLayer) return;
  const vt = currentLayer.viewTarget;
  const sameViewCount = layers.filter(l => l.viewTarget === vt).length;
  if (sameViewCount <= 1) { showToast('각 뷰에 레이어가 최소 1개 있어야 합니다'); return; }
  const idx = layers.indexOf(currentLayer);
  currentLayer.canvas.remove();
  layers.splice(idx, 1);
  currentLayer = layers[Math.min(idx, layers.length - 1)];
  updateZIndex();
  rebuildLayerList();
  redrawAllLayers();
  showToast('레이어 삭제됨');
}

function duplicateLayer() {
  if (!currentLayer) return;
  const src = currentLayer;
  addLayer(src.name + " copy", src.viewTarget || 'front');
  const dest = currentLayer;
  dest.ctx.drawImage(src.canvas, 0, 0);
  dest.visible = src.visible;
  dest.locked = src.locked;
  dest.blendMode = src.blendMode;
  dest.viewTarget = src.viewTarget || 'front';
  dest.canvas.style.opacity = src.canvas.style.opacity;
  dest.canvas.style.mixBlendMode = src.blendMode;
  dest.shapes = JSON.parse(JSON.stringify(src.shapes));
  saveHistory(dest);
  rebuildLayerList();
  redrawAllLayers();
  showToast('레이어 복제 완료');
}

function mergeDown() {
  if (!currentLayer) return;
  const idx = layers.indexOf(currentLayer);
  if (idx === 0) { showToast('아래에 병합할 레이어가 없습니다'); return; }
  // Guard: only merge with a layer in the same view
  const below = layers[idx - 1];
  if (below.viewTarget !== currentLayer.viewTarget) {
    showToast('같은 뷰의 레이어끼리만 병합할 수 있습니다'); return;
  }
  const above = layers[idx];
  below.ctx.save();
  below.ctx.globalAlpha = parseFloat(above.canvas.style.opacity) || 1;
  below.ctx.globalCompositeOperation = above.blendMode || 'source-over';
  below.ctx.drawImage(above.canvas, 0, 0);
  below.ctx.restore();
  below.shapes = below.shapes.concat(JSON.parse(JSON.stringify(above.shapes)));
  above.canvas.remove();
  layers.splice(idx, 1);
  currentLayer = below;
  updateZIndex();
  saveHistory(below);
  rebuildLayerList();
  redrawAllLayers();
  showToast('레이어 병합 완료');
}

function moveLayerUp() {
  if (!currentLayer) return;
  const idx = layers.indexOf(currentLayer);
  if (idx < layers.length - 1) {
    [layers[idx], layers[idx + 1]] = [layers[idx + 1], layers[idx]];
    updateZIndex(); rebuildLayerList(); redrawAllLayers();
  }
}

function moveLayerDown() {
  if (!currentLayer) return;
  const idx = layers.indexOf(currentLayer);
  if (idx > 0) {
    [layers[idx], layers[idx - 1]] = [layers[idx - 1], layers[idx]];
    updateZIndex(); rebuildLayerList(); redrawAllLayers();
  }
}

function updateZIndex() {
  // z-index only matters within each host's stacking context
  // Assign independently per view
  let frontIdx = 0, sideIdx = 0;
  layers.forEach(l => {
    if (l.viewTarget === 'side') {
      l.canvas.style.zIndex = sideIdx++;
    } else {
      l.canvas.style.zIndex = frontIdx++;
    }
  });
}

function setOpacity(value) {
  if (!currentLayer) return;
  currentLayer.canvas.style.opacity = value;
  document.getElementById('opacityVal').textContent = Math.round(value * 100) + '%';
  redrawAllLayers();
}

function setBlendMode(mode) {
  if (!currentLayer) return;
  currentLayer.blendMode = mode;
  currentLayer.canvas.style.mixBlendMode = mode;
  rebuildLayerList();
}

function toggleVisibility(layer) {
  const l = layer || currentLayer;
  if (!l) return;
  l.visible = !l.visible;
  l.canvas.style.display = l.visible ? 'block' : 'none';
  rebuildLayerList(); redrawAllLayers();
}

function toggleLock(layer) {
  const l = layer || currentLayer;
  if (!l) return;
  l.locked = !l.locked;
  rebuildLayerList();
}

function renameLayerInline(idx) {
  const item = document.querySelector(`.layer-item[data-idx="${idx}"]`);
  if (!item) return;
  const nameEl = item.querySelector('.layer-name');
  const currentName = layers[idx].name;
  const input = document.createElement('input');
  input.className = 'layer-name-edit';
  input.value = currentName;
  nameEl.replaceWith(input);
  input.focus(); input.select();
  const commit = () => { layers[idx].name = input.value.trim() || currentName; rebuildLayerList(); };
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') input.blur();
    if (e.key === 'Escape') { layers[idx].name = currentName; input.blur(); }
  });
}

// ═══════════════════════════════════════════════
// LAYER LIST UI
// ═══════════════════════════════════════════════
function rebuildLayerList() {
  const list = document.getElementById('layer-list');
  list.innerHTML = '';
  if (layers.length === 0) {
    list.innerHTML = '<div class="empty-state">레이어가 없습니다</div>';
    document.getElementById('layerCount').textContent = '0';
    return;
  }
  document.getElementById('layerCount').textContent = layers.length;

  for (let i = layers.length - 1; i >= 0; i--) {
    const layer = layers[i];
    const isActive = layer === currentLayer;

    const item = document.createElement('div');
    item.className = 'layer-item' + (isActive ? ' active' : '');
    item.dataset.idx = i;
    item.draggable = true;

    const thumb = document.createElement('div');
    thumb.className = 'layer-thumb';
    const thumbCanvas = document.createElement('canvas');
    thumbCanvas.width = 72; thumbCanvas.height = 54;
    thumbCanvas.getContext('2d').drawImage(layer.canvas, 0, 0, 72, 54);
    thumb.appendChild(thumbCanvas);

    const handle = document.createElement('div');
    handle.className = 'layer-drag-handle';
    handle.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="5" r="1.5" fill="currentColor"/><circle cx="15" cy="5" r="1.5" fill="currentColor"/><circle cx="9" cy="12" r="1.5" fill="currentColor"/><circle cx="15" cy="12" r="1.5" fill="currentColor"/><circle cx="9" cy="19" r="1.5" fill="currentColor"/><circle cx="15" cy="19" r="1.5" fill="currentColor"/></svg>`;

    const info = document.createElement('div');
    info.className = 'layer-info';
    const nameEl = document.createElement('div');
    nameEl.className = 'layer-name';
    nameEl.textContent = layer.name;
    nameEl.addEventListener('dblclick', e => { e.stopPropagation(); renameLayerInline(i); });
    const badges = document.createElement('div');
    badges.className = 'layer-badges';
    const vtLabel = layer.viewTarget === 'side' ? 'SIDE' : 'FRONT';
    const vtBg  = layer.viewTarget === 'side' ? '#0f2d1e' : '#1e1b4b';
    const vtFg  = layer.viewTarget === 'side' ? '#34d399' : '#a5b4fc';
    badges.innerHTML += `<span class="layer-badge" style="background:${vtBg};color:${vtFg};">${vtLabel}</span>`;
    if (!layer.visible) badges.innerHTML += `<span class="layer-badge badge-hidden">HIDDEN</span>`;
    if (layer.locked)   badges.innerHTML += `<span class="layer-badge badge-locked">LOCKED</span>`;
    if (layer.blendMode !== 'source-over') badges.innerHTML += `<span class="layer-badge badge-blend">${layer.blendMode}</span>`;
    info.appendChild(nameEl);
    if (badges.children.length) info.appendChild(badges);

    const actions = document.createElement('div');
    actions.className = 'layer-actions';

    const visBtn = document.createElement('button');
    visBtn.className = 'btn btn-icon' + (!layer.visible ? ' active-icon' : '');
    visBtn.title = layer.visible ? '숨기기' : '표시하기';
    visBtn.innerHTML = layer.visible
      ? `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`
      : `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`;
    visBtn.addEventListener('click', e => { e.stopPropagation(); toggleVisibility(layer); });

    const lockBtn = document.createElement('button');
    lockBtn.className = 'btn btn-icon' + (layer.locked ? ' lock-icon' : '');
    lockBtn.title = layer.locked ? '잠금 해제' : '잠금';
    lockBtn.innerHTML = layer.locked
      ? `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`
      : `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>`;
    lockBtn.addEventListener('click', e => { e.stopPropagation(); toggleLock(layer); });

    const delBtn = document.createElement('button');
    delBtn.className = 'btn btn-icon del-icon';
    delBtn.title = '삭제';
    delBtn.innerHTML = `<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>`;
    delBtn.addEventListener('click', e => { e.stopPropagation(); selectLayerByIndex(i); deleteCurrentLayer(); });

    actions.append(visBtn, lockBtn, delBtn);
    item.append(handle, thumb, info, actions);
    item.addEventListener('click', () => selectLayerByIndex(i));

    // Drag & Drop
    item.addEventListener('dragstart', e => {
      dragSrcIndex = i;
      setTimeout(() => item.classList.add('dragging'), 0);
      e.dataTransfer.effectAllowed = 'move';
    });
    item.addEventListener('dragend', () => {
      item.classList.remove('dragging');
      document.querySelectorAll('.layer-item.drag-over').forEach(el => el.classList.remove('drag-over'));
    });
    item.addEventListener('dragover', e => {
      e.preventDefault();
      document.querySelectorAll('.layer-item.drag-over').forEach(el => el.classList.remove('drag-over'));
      item.classList.add('drag-over');
    });
    item.addEventListener('drop', e => {
      e.preventDefault();
      if (dragSrcIndex === null || dragSrcIndex === i) return;
      const moved = layers.splice(dragSrcIndex, 1)[0];
      layers.splice(i, 0, moved);
      currentLayer = moved;
      updateZIndex(); rebuildLayerList(); redrawAllLayers();
      dragSrcIndex = null;
    });

    list.appendChild(item);
  }

  if (currentLayer) {
    document.getElementById('blendMode').value = currentLayer.blendMode || 'source-over';
    const op = parseFloat(currentLayer.canvas.style.opacity);
    const opVal = isNaN(op) ? 1 : op;
    document.getElementById('opacity').value = opVal;
    document.getElementById('opacityVal').textContent = Math.round(opVal * 100) + '%';
  }
}

function selectLayerByIndex(i) {
  currentLayer = layers[i];
  selectedShape = null;
  selectedNodeKey = null;
  updateShapeList();
  updateSelectedShapeInfo();
  rebuildLayerList();
  redrawAllLayers();
}

function refreshThumbnails() {
  document.querySelectorAll('.layer-item').forEach(item => {
    const idx = parseInt(item.dataset.idx);
    if (isNaN(idx) || !layers[idx]) return;
    const tc = item.querySelector('.layer-thumb canvas');
    if (!tc) return;
    tc.getContext('2d').clearRect(0, 0, 72, 54);
    tc.getContext('2d').drawImage(layers[idx].canvas, 0, 0, 72, 54);
  });
}

// ═══════════════════════════════════════════════
// HISTORY
// ═══════════════════════════════════════════════
function saveHistory(layer) {
  if (!layer) return;
  layer.historyStep++;
  layer.history.length = layer.historyStep;
  layer.history.push({
    imageData: layer.ctx.getImageData(0, 0, layer.canvas.width, layer.canvas.height),
    shapes: JSON.parse(JSON.stringify(layer.shapes))   // deep-copy vector shapes
  });
  if (layer.history.length > MAX_HISTORY) {
    layer.history.shift(); layer.historyStep--;
  }
}

function undo() {
  if (!currentLayer || currentLayer.historyStep <= 0) return;
  currentLayer.historyStep--;
  const snap = currentLayer.history[currentLayer.historyStep];
  currentLayer.ctx.putImageData(snap.imageData, 0, 0);
  currentLayer.shapes = JSON.parse(JSON.stringify(snap.shapes));
  if (toolMode === 'edit') { selectedShape = null; selectedNodeKey = null; updateShapeList(); updateSelectedShapeInfo(); }
  redrawAllLayers();
  setTimeout(refreshThumbnails, 50);
}

function redo() {
  if (!currentLayer || currentLayer.historyStep >= currentLayer.history.length - 1) return;
  currentLayer.historyStep++;
  const snap = currentLayer.history[currentLayer.historyStep];
  currentLayer.ctx.putImageData(snap.imageData, 0, 0);
  currentLayer.shapes = JSON.parse(JSON.stringify(snap.shapes));
  if (toolMode === 'edit') { selectedShape = null; selectedNodeKey = null; updateShapeList(); updateSelectedShapeInfo(); }
  redrawAllLayers();
  setTimeout(refreshThumbnails, 50);
}

// ═══════════════════════════════════════════════
// DRAWING — pointer events
// ═══════════════════════════════════════════════
function startDraw(e) {
  if (!currentLayer || currentLayer.locked || !currentLayer.visible) return;
  const rect = currentLayer.canvas.getBoundingClientRect();
  const rawX = e.clientX - rect.left, rawY = e.clientY - rect.top;

  if (measureMode) { handleMeasurePoint(rawX, rawY); return; }
  if (toolMode === "bezier") { handleBezierClick(rawX, rawY); return; }
  if (toolMode === "fill")   { handleFillClick(rawX, rawY);   return; }

  drawing = true;
  lastX = rawX; lastY = rawY;  // reset before any draw segment
}

function draw(e) {
  if (!currentLayer) return;
  const rect = currentLayer.canvas.getBoundingClientRect();
  const x = e.clientX - rect.left, y = e.clientY - rect.top;

  // ── Bezier shape node drag (fill tool has no drag) ──
  if (toolMode === "fill") return; // fill is click-only

  if (!drawing || currentLayer.locked || !currentLayer.visible || toolMode === "bezier") return;

  const ctx = currentLayer.ctx;
  const baseWidth = parseFloat(document.getElementById("lineWidth").value);
  const pressure = (e.pressure !== undefined && e.pressure > 0) ? e.pressure : 1;
  const lineWidth = Math.max(1, baseWidth * pressure);

  // ── ERASER ──────────────────────────────────────────
  if (toolMode === "eraser") {
    const half = lineWidth / 2;
    ctx.save();
    ctx.globalCompositeOperation = "destination-out";
    ctx.beginPath();
    if (document.getElementById("brushStyle").value === "square") {
      ctx.fillRect(x - half, y - half, lineWidth, lineWidth);
    } else {
      ctx.arc(x, y, half, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
    lastX = x; lastY = y;
    return;
  }

  // ── BRUSH ────────────────────────────────────────────
  const color = document.getElementById("colorPicker").value;
  const capStyle = document.getElementById("brushStyle").value === "square" ? "square" : "round";

  // Each segment is its own path to avoid cross-segment color/width bleed
  ctx.beginPath();
  ctx.moveTo(lastX, lastY);
  ctx.lineTo(x, y);
  ctx.strokeStyle = color;
  ctx.lineWidth = lineWidth;
  ctx.lineCap = capStyle;
  ctx.lineJoin = "round";   // BUG FIX: prevent miter spikes at corners
  ctx.stroke();

  if (symmetryMode) {
    const W = currentLayer.canvas.width;
    const mX  = W - x    - 1;
    const mLX = W - lastX - 1;
    ctx.beginPath();
    ctx.moveTo(mLX, lastY);
    ctx.lineTo(mX, y);
    ctx.strokeStyle = color;
    ctx.lineWidth = lineWidth;
    ctx.lineCap = capStyle;
    ctx.lineJoin = "round";
    ctx.stroke();
    // BUG FIX: do NOT leave an open path here — always close with stroke
  }
  lastX = x; lastY = y;
}

function endDraw() {
  if (drawing) {
    drawing = false;
    saveHistory(currentLayer);
    redrawAllLayers();
    setTimeout(refreshThumbnails, 50);
  }
  // fill: nothing extra on pointer-up
}

// ═══════════════════════════════════════════════
// BEZIER CLICK HANDLER  (fully redesigned)
// ═══════════════════════════════════════════════
function handleBezierClick(rawX, rawY) {
  let { x, y } = snapPoint(rawX, rawY);

  const totalSteps = bezierStepCount(); // 3 or 4
  const continuous = document.getElementById('bezierContinuous').checked;
  const closePath  = document.getElementById('bezierClosePath').checked;

  // Close-path snap: only when placing P1 (index 1), not during CP steps
  if (closePath && bPts.length === 1 && nearFirstPoint(x, y)) {
    x = bPts[0].x; y = bPts[0].y;
  }

  bPts.push({ x, y });
  updateBezierStepUI();

  if (bPts.length === totalSteps) {
    commitBezierShape(closePath);
  }

  redrawAllLayers();
}

function commitBezierShape(closePath) {
  const color = document.getElementById("colorPicker").value;
  const width = parseFloat(document.getElementById("lineWidth").value);
  const fill  = document.getElementById('bezierFill').checked;
  const fillColor = document.getElementById('fillColor').value;
  const continuous = document.getElementById('bezierContinuous').checked;

  let shape;
  const p1ForContinuous = { ...bPts[1] }; // save end-point before clearing

  if (bezierMode === 'quadratic') {
    shape = {
      type: 'bezier',
      p0:   { ...bPts[0] },
      p1:   { ...bPts[1] },
      cp:   { ...bPts[2] },
      closed: closePath,
      fill, fillColor,
      color, width
    };
  } else {
    // cubic: p0, p1, cp1, cp2
    shape = {
      type: 'cubic',
      p0:   { ...bPts[0] },
      p1:   { ...bPts[1] },
      cp1:  { ...bPts[2] },
      cp2:  { ...bPts[3] },
      closed: closePath,
      fill, fillColor,
      color, width
    };
  }

  currentLayer.shapes.push(shape);
  saveHistory(currentLayer);
  setTimeout(refreshThumbnails, 50);

  if (toolMode === 'edit') updateShapeList();

  // Reset bPts — optionally seed from p1 for continuous
  if (continuous) {
    bPts = [{ ...p1ForContinuous }];
  } else {
    bPts = [];
  }
  updateBezierStepUI();
}

// ═══════════════════════════════════════════════
// FILL TOOL  — scanline flood fill
// ═══════════════════════════════════════════════
function handleFillClick(x, y) {
  if (!currentLayer) return;
  const ctx = currentLayer.ctx;
  const W = currentLayer.canvas.width;
  const H = currentLayer.canvas.height;
  const px = Math.floor(x), py = Math.floor(y);
  if (px < 0 || py < 0 || px >= W || py >= H) return;

  const imageData = ctx.getImageData(0, 0, W, H);
  const data = imageData.data;

  // Parse fill color
  const fillHex = document.getElementById('fillToolColor').value;
  const fr = parseInt(fillHex.slice(1, 3), 16);
  const fg = parseInt(fillHex.slice(3, 5), 16);
  const fb = parseInt(fillHex.slice(5, 7), 16);
  const fa = 255;

  const tolerance = parseInt(document.getElementById('fillTolerance').value);
  const antiAlias = document.getElementById('fillAntiAlias').checked;

  const idx = (py * W + px) * 4;
  const tr = data[idx], tg = data[idx+1], tb = data[idx+2], ta = data[idx+3];

  // If clicked pixel already matches fill color, bail
  if (tr === fr && tg === fg && tb === fb && ta === fa) return;

  function colorMatch(i) {
    return Math.abs(data[i]   - tr) <= tolerance &&
           Math.abs(data[i+1] - tg) <= tolerance &&
           Math.abs(data[i+2] - tb) <= tolerance &&
           Math.abs(data[i+3] - ta) <= tolerance;
  }

  // Scanline stack flood fill (efficient for large areas)
  const visited = new Uint8Array(W * H);
  const stack = [[px, py]];

  while (stack.length > 0) {
    const [cx, cy] = stack.pop();
    if (cx < 0 || cx >= W || cy < 0 || cy >= H) continue;
    const ci = cy * W + cx;
    if (visited[ci]) continue;

    const di = ci * 4;
    if (!colorMatch(di)) continue;

    visited[ci] = 1;
    data[di]   = fr;
    data[di+1] = fg;
    data[di+2] = fb;
    data[di+3] = fa;

    stack.push([cx+1, cy], [cx-1, cy], [cx, cy+1], [cx, cy-1]);
  }

  // Anti-alias: blend boundary pixels
  if (antiAlias) {
    for (let cy = 0; cy < H; cy++) {
      for (let cx = 0; cx < W; cx++) {
        const ci = cy * W + cx;
        if (!visited[ci]) continue;
        // Check if any 4-neighbor is NOT visited
        const hasEdge = (
          (cx > 0     && !visited[ci - 1]) ||
          (cx < W - 1 && !visited[ci + 1]) ||
          (cy > 0     && !visited[ci - W]) ||
          (cy < H - 1 && !visited[ci + W])
        );
        if (!hasEdge) continue;
        // Blend fill color with original at 50% on boundary
        const di = ci * 4;
        data[di]   = Math.round((fr + tr) / 2);
        data[di+1] = Math.round((fg + tg) / 2);
        data[di+2] = Math.round((fb + tb) / 2);
        data[di+3] = Math.round((fa + ta) / 2);
      }
    }
  }

  ctx.putImageData(imageData, 0, 0);
  saveHistory(currentLayer);
  redrawAllLayers();
  setTimeout(refreshThumbnails, 50);
}

// ═══════════════════════════════════════════════
// REDRAW ENGINE
// ═══════════════════════════════════════════════
function redrawAllLayers() {
  layers.forEach(layer => {
    if (!layer.visible) {
      // Clear hidden layer canvas so it doesn't bleed through
      layer.ctx.clearRect(0, 0, layer.canvas.width, layer.canvas.height);
      return;
    }
    const snap = layer.history[layer.historyStep];
    if (snap) {
      layer.ctx.putImageData(snap.imageData, 0, 0);
    } else {
      layer.ctx.clearRect(0, 0, layer.canvas.width, layer.canvas.height);
    }

    // Render all vector shapes on top of raster history
    layer.shapes.forEach(s => {
      if (s.type === 'bezier') drawQuadraticShape(layer.ctx, s);
      else if (s.type === 'cubic') drawCubicShape(layer.ctx, s);
    });
  });

  if (currentLayer && currentLayer.visible && !currentLayer.locked) {
    const ctx = currentLayer.ctx;
    if (proportionOverlayActive) drawProportionOverlay(ctx);
    if (poseGuideActive)         drawSymmetryPoseGuide(ctx);
    if (toolMode === "bezier")   drawBezierPreview(ctx);
    // fill tool: no overlay needed
  }
}

// ─── shape renderers ──────────────────────────
function drawQuadraticShape(ctx, s) {
  ctx.save();
  ctx.strokeStyle = s.color; ctx.lineWidth = s.width; ctx.lineCap = "round";
  ctx.beginPath();
  ctx.moveTo(s.p0.x, s.p0.y);
  ctx.quadraticCurveTo(s.cp.x, s.cp.y, s.p1.x, s.p1.y);
  if (s.closed) ctx.closePath();
  if (s.fill) { ctx.fillStyle = s.fillColor || s.color; ctx.fill(); }
  ctx.stroke();

  if (symmetryMode) {
    const W = ctx.canvas.width;
    ctx.beginPath();
    ctx.moveTo(W - s.p0.x, s.p0.y);
    ctx.quadraticCurveTo(W - s.cp.x, s.cp.y, W - s.p1.x, s.p1.y);
    if (s.closed) ctx.closePath();
    if (s.fill) { ctx.fillStyle = s.fillColor || s.color; ctx.fill(); }
    ctx.stroke();
  }
  ctx.restore();
}

function drawCubicShape(ctx, s) {
  ctx.save();
  ctx.strokeStyle = s.color; ctx.lineWidth = s.width; ctx.lineCap = "round";
  ctx.beginPath();
  ctx.moveTo(s.p0.x, s.p0.y);
  ctx.bezierCurveTo(s.cp1.x, s.cp1.y, s.cp2.x, s.cp2.y, s.p1.x, s.p1.y);
  if (s.closed) ctx.closePath();
  if (s.fill) { ctx.fillStyle = s.fillColor || s.color; ctx.fill(); }
  ctx.stroke();

  if (symmetryMode) {
    const W = ctx.canvas.width;
    ctx.beginPath();
    ctx.moveTo(W - s.p0.x, s.p0.y);
    ctx.bezierCurveTo(W - s.cp1.x, s.cp1.y, W - s.cp2.x, s.cp2.y, W - s.p1.x, s.p1.y);
    if (s.closed) ctx.closePath();
    if (s.fill) ctx.fill();
    ctx.stroke();
  }
  ctx.restore();
}

// ─── live bezier preview while placing points ─
function drawBezierPreview(ctx) {
  if (bPts.length === 0) return;

  const mx = mousePos.x, my = mousePos.y;
  const color = document.getElementById("colorPicker").value;
  const width = parseFloat(document.getElementById("lineWidth").value);

  ctx.save();

  // Draw already-placed anchor dots
  bPts.forEach((p, i) => {
    const colors = ['#10b981', '#ef4444', '#f59e0b', '#3b82f6'];
    ctx.fillStyle = colors[i] || '#fff';
    ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, Math.PI * 2); ctx.fill();
    // Label
    ctx.fillStyle = colors[i] || '#fff';
    ctx.font = 'bold 10px DM Mono, monospace';
    ctx.fillText(bezierStepLabels()[i].label, p.x + 7, p.y - 7);
  });

  // Dashed guide line only from the last placed point to mouse
  ctx.strokeStyle = 'rgba(148,163,184,0.4)';
  ctx.lineWidth = 1;
  ctx.setLineDash([3, 3]);
  const lastPt = bPts[bPts.length - 1];
  ctx.beginPath(); ctx.moveTo(lastPt.x, lastPt.y); ctx.lineTo(mx, my); ctx.stroke();

  // Phantom (preview) curve based on how many points placed
  ctx.setLineDash([5, 4]);
  ctx.lineWidth = width;
  ctx.strokeStyle = color;
  ctx.globalAlpha = 0.55;

  if (bezierMode === 'quadratic') {
    if (bPts.length === 1) {
      // Straight line from P0 to mouse (P1 preview)
      ctx.beginPath(); ctx.moveTo(bPts[0].x, bPts[0].y); ctx.lineTo(mx, my); ctx.stroke();
    } else if (bPts.length === 2) {
      // Full quadratic preview: P0-P1 with mouse as CP
      ctx.beginPath();
      ctx.moveTo(bPts[0].x, bPts[0].y);
      ctx.quadraticCurveTo(mx, my, bPts[1].x, bPts[1].y);
      ctx.stroke();
    }
  } else {
    // cubic
    if (bPts.length === 1) {
      ctx.beginPath(); ctx.moveTo(bPts[0].x, bPts[0].y); ctx.lineTo(mx, my); ctx.stroke();
    } else if (bPts.length === 2) {
      // cp1 step: preview cubic with mouse as both control points (symmetric feel)
      ctx.beginPath();
      ctx.moveTo(bPts[0].x, bPts[0].y);
      ctx.bezierCurveTo(mx, my, mx, my, bPts[1].x, bPts[1].y);
      ctx.stroke();
    } else if (bPts.length === 3) {
      // have p0, p1, cp1 — preview with mouse as cp2
      ctx.beginPath();
      ctx.moveTo(bPts[0].x, bPts[0].y);
      ctx.bezierCurveTo(bPts[2].x, bPts[2].y, mx, my, bPts[1].x, bPts[1].y);
      ctx.stroke();
    }
  }

  // Symmetry preview
  if (symmetryMode) {
    const W = ctx.canvas.width;
    ctx.globalAlpha = 0.35;
    ctx.setLineDash([4, 5]);
    if (bezierMode === 'quadratic' && bPts.length === 2) {
      ctx.beginPath();
      ctx.moveTo(W - bPts[0].x, bPts[0].y);
      ctx.quadraticCurveTo(W - mx, my, W - bPts[1].x, bPts[1].y);
      ctx.stroke();
    } else if (bezierMode === 'cubic' && bPts.length === 3) {
      ctx.beginPath();
      ctx.moveTo(W - bPts[0].x, bPts[0].y);
      ctx.bezierCurveTo(W - bPts[2].x, bPts[2].y, W - mx, my, W - bPts[1].x, bPts[1].y);
      ctx.stroke();
    }
  }

  ctx.restore();
}

// drawNodeHandles removed — replaced by fill tool

// ─── proportion / pose guide ──────────────────
function drawProportionOverlay(ctx) {
  ctx.save();
  ctx.strokeStyle = "rgba(16,185,129,0.35)"; ctx.lineWidth = 1.5; ctx.setLineDash([3, 3]);
  ctx.font = "10px sans-serif"; ctx.fillStyle = "rgba(16,185,129,0.75)";
  const topY = 80, botY = 500, height = botY - topY;
  const steps = Math.max(2, Math.round(calculatedRatio));
  for (let i = 0; i <= steps; i++) {
    const currY = topY + (height / steps) * i;
    ctx.beginPath(); ctx.moveTo(50, currY); ctx.lineTo(750, currY); ctx.stroke();
    ctx.fillText(`${i} F`, 20, currY + 4);
  }
  ctx.restore();
}

function drawSymmetryPoseGuide(ctx) {
  ctx.save();
  ctx.strokeStyle = "rgba(59,130,246,0.4)"; ctx.lineWidth = 1;
  ctx.font = "9px sans-serif"; ctx.fillStyle = "rgba(59,130,246,0.7)";
  const mid = ctx.canvas.width / 2, topY = 80, botY = 500;
  const stepH = (botY - topY) / Math.max(2, Math.round(calculatedRatio));
  const headCY = topY + stepH / 2, headRY = stepH / 2, headRX = headRY * 0.75;
  ctx.beginPath(); ctx.ellipse(mid, headCY, headRX, headRY, 0, 0, Math.PI * 2); ctx.stroke();
  ctx.setLineDash([2, 4]);
  ctx.beginPath(); ctx.moveTo(mid - headRX, headCY); ctx.lineTo(mid + headRX, headCY); ctx.stroke();
  ctx.fillText("눈/귀 선", mid + headRX + 5, headCY + 3);
  if (calculatedRatio >= 3) {
    const chestY = topY + stepH * 1.5;
    ctx.beginPath(); ctx.moveTo(mid - 60, chestY); ctx.lineTo(mid + 60, chestY); ctx.stroke();
    ctx.fillText("바스트", mid + 65, chestY + 3);
  }
  const pelvisIndex = calculatedRatio <= 4 ? 2 : 3;
  const pelvisY = topY + stepH * pelvisIndex;
  ctx.beginPath(); ctx.moveTo(mid - 50, pelvisY); ctx.lineTo(mid + 50, pelvisY); ctx.stroke();
  ctx.fillText("골반", mid + 55, pelvisY + 3);
  ctx.restore();
}

// ═══════════════════════════════════════════════
// GUIDE & OVERLAYS
