}

// ═══════════════════════════════════════════════
// RATIO ANALYZER
// ═══════════════════════════════════════════════
function classifyCharacter(ratio) {
  return (CharacterTypes.find(t => ratio <= t.maxRatio) || { name: "미분류" }).name;
}

function startRatioMeasure() {
  measureMode = true; headTop = null; chin = null; foot = null;
  alert("비율 측정:\n1. 머리 꼭대기 → 2. 턱 끝 → 3. 발바닥 순서로 클릭하세요.");
}

function handleMeasurePoint(x, y) {
  const ctx = currentLayer.ctx;
  ctx.fillStyle = "#10b981";
  ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fill();
  if (!headTop) { headTop = { x, y }; return; }
  if (!chin) { chin = { x, y }; return; }
  foot = { x, y }; measureMode = false;
  const hh = chin.y - headTop.y, bh = foot.y - headTop.y;
  if (hh <= 0 || bh <= 0) { alert("위에서 아래 순으로 클릭해 주세요."); return; }
  calculatedRatio = bh / hh;
  calculatedType = classifyCharacter(calculatedRatio);
  updateAnalyzerUI(calculatedRatio, calculatedType);
  saveHistory(currentLayer);
  redrawAllLayers();
  setTimeout(refreshThumbnails, 50);
}

function updateAnalyzerUI(ratio, typeName) {
  let feedback = "", genre = "";
  if (ratio <= 2.5) { feedback = "머리가 크고 극대화된 데포르메. 귀여움과 소형 캐릭터에 최적화."; genre = "캐주얼 굿즈, 미니 피규어, 이모티콘"; }
  else if (ratio <= 4.0) { feedback = "안정적인 SD 등신. 조형적 가독성이 뛰어납니다."; genre = "플랫포머 게임 원화, 하이퍼 캐주얼 일러스트"; }
  else if (ratio <= 6.5) { feedback = "서브컬처에서 가장 사랑받는 반실사 스타일."; genre = "웹툰 키비주얼, 캐주얼 모바일 RPG 컨셉"; }
  else { feedback = "긴 하체와 우아한 골반 라인. 해부학 정확도와 실사 중심의 품격."; genre = "하이 실사형 RPG 원화, 아트북 일러스트"; }
  document.getElementById("characterType").innerHTML = `
    <div class="analyzer-title">Analysis Results</div>
    <div style="margin-top:4px;">분류 : <span class="badge-type">${typeName}</span></div>
    <div>등신 : <span class="analyzer-val">약 ${ratio.toFixed(1)} 등신</span></div>
    <div style="margin-top:8px;border-top:1px solid var(--border-subtle);padding-top:8px;">
      <span style="color:var(--accent);font-weight:700;">체형 피드백</span><br>
      <span style="color:var(--text-secondary);">${feedback}</span>
    </div>
    <div style="margin-top:6px;">
      <span style="color:var(--green);font-weight:700;">추천 장르</span><br>
      <span style="color:var(--text-secondary);">${genre}</span>
    </div>`;
}

// ═══════════════════════════════════════════════
// EXPORT / IMPORT
// ═══════════════════════════════════════════════
function exportProject() {
  const data = {
    version: "3.0",
    guides: { symmetry: symmetryMode },
    characterAnalysis: { ratio: calculatedRatio, type: calculatedType },
    layers: layers.map(l => ({
      name: l.name, opacity: l.canvas.style.opacity || "1",
      visible: l.visible, locked: l.locked,
      blendMode: l.blendMode || "source-over",
      shapes: l.shapes || [],
      viewTarget: l.viewTarget || 'front',
      imageData: l.canvas.toDataURL()
    }))
  };
  const a = document.createElement('a');
  a.href = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(data));
  a.download = "ocs_project.json"; a.click();
}

function importProject(event) {
  const file = event.target.files[0]; if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      layers.forEach(l => l.canvas.remove()); layers = [];
      symmetryMode = data.guides.symmetry;
      document.getElementById("symmetryToggle").checked = symmetryMode;
      calculatedRatio = data.characterAnalysis.ratio || 6.0;
      calculatedType  = data.characterAnalysis.type  || "MD";
      if (data.characterAnalysis.ratio) updateAnalyzerUI(calculatedRatio, calculatedType);
      data.layers.forEach(ld => {
        addLayer(ld.name, ld.viewTarget || 'front');
        const tl = layers[layers.length - 1];
        tl.visible = ld.visible; tl.locked = ld.locked;
        tl.blendMode = ld.blendMode || "source-over";
        tl.viewTarget = ld.viewTarget || 'front';
        tl.shapes = ld.shapes || [];
        tl.canvas.style.opacity = ld.opacity;
        tl.canvas.style.mixBlendMode = tl.blendMode;
        tl.canvas.style.display = tl.visible ? 'block' : 'none';
        const img = new Image();
        img.onload = () => { tl.ctx.drawImage(img, 0, 0); saveHistory(tl); redrawAllLayers(); setTimeout(refreshThumbnails, 100); };
        img.src = ld.imageData;
      });
      rebuildLayerList();
    } catch { alert("유효하지 않은 OCS 파일입니다."); }
  };
  reader.readAsText(file);
}

function exportImage() {
  // Export current active view only (or both side-by-side if split)
  const frontLayers = layers.filter(l => l.viewTarget !== 'side');
  const sideLayers  = layers.filter(l => l.viewTarget === 'side');

  function compositeView(layerList) {
    const c = document.createElement("canvas");
    c.width = 800; c.height = 600;
    const ctx = c.getContext("2d");
    ctx.fillStyle = "#0f172a"; ctx.fillRect(0,0,800,600);
    layerList.forEach(l => {
      if (!l.visible) return;
      ctx.save();
      ctx.globalAlpha = parseFloat(l.canvas.style.opacity) || 1;
      ctx.globalCompositeOperation = l.blendMode || "source-over";
      ctx.drawImage(l.canvas, 0, 0);
      ctx.restore();
    });
    return c;
  }

  if (activeView === 'front') {
    const c = compositeView(frontLayers);
    const a = document.createElement('a');
    a.download = "ocs_front.png"; a.href = c.toDataURL(); a.click();
  } else if (activeView === 'side') {
    const c = compositeView(sideLayers);
    const a = document.createElement('a');
    a.download = "ocs_side.png"; a.href = c.toDataURL(); a.click();
  } else {
    // Split: export both side by side in one 1600×600 image
    const ec = document.createElement("canvas");
    ec.width = 1600; ec.height = 600;
    const ectx = ec.getContext("2d");
    ectx.fillStyle = "#0f172a"; ectx.fillRect(0,0,1600,600);
    ectx.drawImage(compositeView(frontLayers), 0, 0);
    ectx.drawImage(compositeView(sideLayers),  800, 0);
    // Divider line
    ectx.strokeStyle = "#2a3a52"; ectx.lineWidth = 2;
    ectx.beginPath(); ectx.moveTo(800,0); ectx.lineTo(800,600); ectx.stroke();
    const a = document.createElement('a');
    a.download = "ocs_character_sheet.png"; a.href = ec.toDataURL(); a.click();
  }
}

function exportSVG() {
  // Build SVG paths for one view's layers
  function buildSVGPaths(layerList, offsetX = 0) {
    let out = '';
    const W = 800;
    layerList.forEach(l => {
      if (!l.visible) return;
      out += `<!-- ${l.name} -->`;
      l.shapes.forEach(s => {
        const ox = offsetX; // horizontal offset for side-by-side
        function px(v) { return v + ox; }
        function mx(v) { return W - v + ox; }
        if (s.type === 'bezier') {
          const d = `M ${px(s.p0.x)} ${s.p0.y} Q ${px(s.cp.x)} ${s.cp.y} ${px(s.p1.x)} ${s.p1.y}${s.closed ? ' Z' : ''}`;
          out += `<path d="${d}" fill="${s.fill ? s.fillColor : 'none'}" stroke="${s.color}" stroke-width="${s.width}" stroke-linecap="round"/>`;
          if (symmetryMode) {
            const d2 = `M ${mx(s.p0.x)} ${s.p0.y} Q ${mx(s.cp.x)} ${s.cp.y} ${mx(s.p1.x)} ${s.p1.y}${s.closed ? ' Z' : ''}`;
            out += `<path d="${d2}" fill="${s.fill ? s.fillColor : 'none'}" stroke="${s.color}" stroke-width="${s.width}" stroke-linecap="round"/>`;
          }
        } else if (s.type === 'cubic') {
          const d = `M ${px(s.p0.x)} ${s.p0.y} C ${px(s.cp1.x)} ${s.cp1.y} ${px(s.cp2.x)} ${s.cp2.y} ${px(s.p1.x)} ${s.p1.y}${s.closed ? ' Z' : ''}`;
          out += `<path d="${d}" fill="${s.fill ? s.fillColor : 'none'}" stroke="${s.color}" stroke-width="${s.width}" stroke-linecap="round"/>`;
          if (symmetryMode) {
            const d2 = `M ${mx(s.p0.x)} ${s.p0.y} C ${mx(s.cp1.x)} ${s.cp1.y} ${mx(s.cp2.x)} ${s.cp2.y} ${mx(s.p1.x)} ${s.p1.y}${s.closed ? ' Z' : ''}`;
            out += `<path d="${d2}" fill="${s.fill ? s.fillColor : 'none'}" stroke="${s.color}" stroke-width="${s.width}" stroke-linecap="round"/>`;
          }
        }
      });
    });
    return out;
  }

  const frontLayers = layers.filter(l => l.viewTarget !== 'side');
  const sideLayers  = layers.filter(l => l.viewTarget === 'side');

  function download(svgStr, filename) {
    const a = document.createElement('a');
    a.href = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgStr);
    a.download = filename; a.click();
  }

  if (activeView === 'front') {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600" style="background:#0f172a;">${buildSVGPaths(frontLayers)}</svg>`;
    download(svg, 'ocs_front.svg');
  } else if (activeView === 'side') {
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600" style="background:#0f172a;">${buildSVGPaths(sideLayers)}</svg>`;
    download(svg, 'ocs_side.svg');
  } else {
    // Split: front on left (0~800), side on right (800~1600)
    const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 600" width="1600" height="600" style="background:#0f172a;">` +
      `<line x1="800" y1="0" x2="800" y2="600" stroke="#2a3a52" stroke-width="1"/>` +
      buildSVGPaths(frontLayers, 0) +
      buildSVGPaths(sideLayers, 800) +
      `</svg>`;
    download(svg, 'ocs_character_sheet.svg');
  }
}

