  ctx.strokeStyle = "#475569";
  ctx.strokeRect(200, 60, 400, 480);  // centered guide box
  ctx.fillStyle = "#94a3b8";
  ctx.fillText(label, 340, 52);
  // Center axis line
  ctx.strokeStyle = "#f43f5e"; ctx.setLineDash([4, 4]);
  ctx.beginPath(); ctx.moveTo(400, 60); ctx.lineTo(400, 540); ctx.stroke();
  ctx.setLineDash([]);
  // Shoulder / waist / hip markers
  const markers = [
    { y: 60 + 480 / 7,       label: '어깨' },
    { y: 60 + 480 * 3 / 7,   label: '허리' },
    { y: 60 + 480 * 4 / 7,   label: '골반' },
  ];
  ctx.strokeStyle = "rgba(99,102,241,0.4)"; ctx.lineWidth = 0.5; ctx.setLineDash([3, 3]);
  markers.forEach(m => {
